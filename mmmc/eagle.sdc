## 
## Cadence bgx_shell "v5.0-s005 (Oct 17 2002 17:15:03)"
## Mon Nov  4 14:18:37 2002
## 
## sdc_write_unambiguous_names global ignored (off) because of the sdc1.1 version
## 
################################################################################
## Change Log
## 11/12/02  mrardon	Changed 'set_load 10' to 'set_load 10 -fanout_number'. 
##			Changed 'set_load 20' to 'set_load 20 -fanout_number'. 
## 11/14/02  mrardon	Condensed multiple false_path statements between clocks
##                      to a single statement. 
##                      Condensed multiple uncertainty statements between clocks
##                      to a single statement. 
## 11/19/02  mrardon	Changed my_clk2x period from 3ns to 4ns.
## 11/22/02  mrardon	Updated clocktree constraints to CTS trials
##                      Latency
##                       my_clk2x	4 => 3.0
##                       my_clk		4 => 2.0
##                       pclk		4 => 2.0
##                       phy_clk	4 => 2.0
##                       phy_rx_clk1	4 => 2.0
##                       phy_rx_clk2	4 => 2.0
##                       phy_tx_clk1	4 => 2.0
##                       phy_tx_clk2	4 => 2.0
##                      Uncertainty
##                       my_clk2x	0.5 => 0.2
##                       my_clk		0.5 => 0.5
##                       pclk		0.5 => 0.2
##                       phy_clk	0.5 => 0.2
##                       phy_rx_clk1	0.5 => 0.2
##                       phy_rx_clk2	0.5 => 0.2
##                       phy_tx_clk1	0.5 => 0.2
##                       phy_tx_clk2	0.5 => 0.2
##                       
################################################################################
set sdc_version 1.1
current_design asic_entity
set_case_analysis 0 [get_ports {scan_enable}]
set_case_analysis 0 [get_ports {test}]


#Clocks
###############################################################################
create_clock [get_ports {clk_cpu}]  -name my_clk2x -period 4 -waveform {0 2}
create_clock [get_ports {clk}]  -name my_clk -period 8 -waveform {0 4}
create_clock [get_ports {vid_pclk}]  -name pclk -period 8 -waveform {0 4}
create_clock [get_ports {utmi_phy_clk}]  -name phy_clk -period 32 -waveform {0 16}
create_clock [get_ports {mii1_rxclk}]  -name phy_rx_clk1 -period 40 -waveform {0 20}
create_clock [get_ports {mii2_rxclk}]  -name phy_rx_clk2 -period 40 -waveform {0 20}
create_clock [get_ports {mii1_txclk}]  -name phy_tx_clk1 -period 40 -waveform {0 20}
create_clock [get_ports {mii2_txclk}]  -name phy_tx_clk2 -period 40 -waveform {0 20}
set_clock_latency  2 [get_clocks {my_clk2x}]
set_clock_latency  3 [get_clocks {my_clk}]
set_clock_latency  2 [get_clocks {pclk}]
set_clock_latency  2 [get_clocks {phy_clk}]
set_clock_latency  2 [get_clocks {phy_rx_clk1}]
set_clock_latency  2 [get_clocks {phy_rx_clk2}]
set_clock_latency  2 [get_clocks {phy_tx_clk1}]
set_clock_latency  2 [get_clocks {phy_tx_clk2}]
set_clock_uncertainty 0.2  -from [get_clocks {my_clk2x}] -to [all_clocks]
set_clock_uncertainty 0.2  -from [get_clocks {my_clk}] -to [all_clocks]
set_clock_uncertainty 0.2  -from [get_clocks {pclk}] -to [all_clocks]
set_clock_uncertainty 0.2  -from [get_clocks {phy_clk}] -to [all_clocks]
set_clock_uncertainty 0.2  -from [get_clocks {phy_rx_clk1}] -to [all_clocks]
set_clock_uncertainty 0.2  -from [get_clocks {phy_rx_clk2}] -to [all_clocks]
set_clock_uncertainty 0.2  -from [get_clocks {phy_tx_clk1}] -to [all_clocks]
set_clock_uncertainty 0.2  -from [get_clocks {phy_tx_clk2}] -to [all_clocks]

